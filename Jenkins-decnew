pipeline{
    agent any
    
    environment{
        PATH = "/opt/maven3/bin:$PATH"
    }
    stages{
        stage("Git Checkout"){
            steps{
                git credentialsId: '211f6c95-bf79-4506-8d65-da34a2e64b36', url: 'https://github.com/pavananingi/myweb.git'
            }
        }
        stage("Maven Build"){
            steps{
                sh "mvn clean package"
                sh "mv target/*.war target/myweb.war"
            }
        }
        stage("deploy-dev"){
            steps{
                sshagent(['a3e80e62-3b37-4608-9e0f-c482b469214f']) {
                sh """
                    scp -o StrictHostKeyChecking=no target/myweb.war  ec2-user@23.22.0.182:/home/ec2-user/apache-tomcat-9.0.85/webapps/
                    
                    ssh ec2-user@23.22.0.182 /home/ec2-user/apache-tomcat-9.0.85/bin/shutdown.sh
                    
                    ssh ec2-user@23.22.0.182 /home/ec2-user/apache-tomcat-9.0.85/bin/startup.sh
                
                """
            }
            
            }
        }
    }
}
